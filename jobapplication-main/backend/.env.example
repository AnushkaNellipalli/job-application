# Copy to .env and export these (or set them in your hosting dashboard).
# Every one is optional in development; the defaults in config/settings.py are used.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (add your deployed Vercel URL here)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
